# API Sherlock — environment variables (never commit a real .env)

# Database (PostgreSQL in Docker/dev; SQLite is allowed for local tests only)
DATABASE_URL=postgresql+psycopg://sherlock:sherlock@localhost:5432/api_sherlock

# API protection: required X-API-Key header on all routes except GET /health
API_KEY=change-me

# CORS: comma-separated origins allowed to call the API from the landing page
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SSRF guard: set to true ONLY for local development against private hosts
ALLOW_PRIVATE_HOSTS=false

# Outgoing request limits
REQUEST_TIMEOUT_SECONDS=10
MAX_RESPONSE_BYTES=2097152
MAX_SPEC_BYTES=5242880

# Runtime
ENVIRONMENT=development
LOG_LEVEL=info
